include $ORIGIN/STM32C5_LPDMA.cs
include $ORIGIN/STM32C5_ADC.cs
include $ORIGIN/STM32C5_SPI.cs
include $ORIGIN/SPIStatefulTarget.cs
include $ORIGIN/STM32C5_TIM2.cs
include $ORIGIN/STM32C5_I2C.cs
include $ORIGIN/I2CRegisterMemory.cs
include $ORIGIN/STM32C5_USB.cs
include $ORIGIN/STM32C5_IWDG.cs
$platform?=$ORIGIN/stm32c552vet6-devkit.repl
mach create "stm32c552vet6-devkit"
machine LoadPlatformDescription $platform
sysbus LoadELF $firmware
cpu VectorTableOffset 0x08000000
