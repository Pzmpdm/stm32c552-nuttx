using "stm32c552vet6-devkit-uart.repl"

gpiob: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

i2c1: I2C.STM32C5_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@44
    ErrorInterrupt -> nvic@45

register_memory: I2C.I2CRegisterMemory @ i2c1 0x50
