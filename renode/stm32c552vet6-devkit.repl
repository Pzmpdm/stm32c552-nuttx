// Model for the board's 48 MHz HSIDIV3, USART1 and user GPIO.
// BOOT0 selects main flash at the reset alias.
flash: Memory.MappedMemory @ {
    sysbus 0x00000000;
    sysbus 0x08000000
}
    size: 0x80000

sram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

sram2: Memory.MappedMemory @ sysbus 0x20010000
    size: 0x10000

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 48000000
    IRQ -> cpu@0

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 48000000
    IRQ -> nvic@51

// LSI is the nominal 32 kHz. A timeout resets the machine. The reload key
// restarts the counter. This is not a measured oscillator or a reset-reason bit.
iwdg: Timers.STM32C5_IWDG @ sysbus 0x40003000
    frequency: 32000

gpioa: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    modeResetValue: 0xEBFFFFFF
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 16

// Ready and switch model. Writes to offset 0x40 inhibit HSE (bit 0),
// PSI (bit 1), the PSIS switch (bit 2), or CK48 divider ready (bit 3).
// System sources stay at the nominal frequency of the loaded platform.
// CK48SEL latches only when PSIDIV3 or HSIDIV3 is ready. HSE is 8 MHz
// and is not accepted as a 48 MHz source. This does not measure 48 MHz.
clock: Python.PythonPeripheral @ sysbus 0x44020C00
    size: 0xE0
    initable: true
    script: '''
if request.IsInit:
    registers = {0x00: 0x22}
elif request.IsWrite:
    offset = request.Offset
    value = request.Value
    if offset == 0x00:
        ready = (1 << 4) | (1 << 5) | (1 << 12) | (1 << 13) | (1 << 17)
        value &= ~ready
        faults = registers.get(0x40, 0)
        if value & (1 << 0):
            value |= 1 << 4
        if value & (1 << 16) and not (faults & 1):
            value |= 1 << 17
        if value & (1 << 8) and value & (1 << 17) and not (faults & 2):
            value |= 1 << 12
        if value & (1 << 1) and value & (1 << 4) and not (faults & 8):
            value |= 1 << 5
        if value & (1 << 9) and value & (1 << 12) and not (faults & 8):
            value |= 1 << 13
    elif offset == 0x1c:
        source = value & 3
        ready_bit = [5, 4, 17, 12][source]
        status = registers.get(0x1c, 0) & 0x18
        switch_blocked = source == 3 and registers.get(0x40, 0) & 4
        if registers[0] & (1 << ready_bit) and not switch_blocked:
            status = source << 3
        value = (value & ~0x18) | status
    elif offset == 0xdc:
        sel = (value >> 24) & 3
        cr1 = registers.get(0, 0)
        ready = (sel == 1 and cr1 & (1 << 13)) or (sel == 2 and cr1 & (1 << 5))
        old = registers.get(0xdc, 0)
        if not ready:
            value = (value & ~(3 << 24)) | (old & (3 << 24))
    registers[offset] = value
elif request.IsRead:
    request.Value = registers.get(request.Offset, 0)
'''

rcc_gates: Memory.ArrayMemory @ sysbus 0x44020CE0
    size: 0x320

// STM32WBA shares the GPIO source and edge layout. Its model does not
// reproduce the C5 interrupt/event mask or pending-register behavior.
exti: IRQControllers.STM32WBA_EXTI @ sysbus 0x44022000
    numberOfOutputLines: 24
    13 -> nvic@20

gpioc: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16
    13 -> exti#2@13

gpioh: GPIOPort.STM32_GPIOPort @ sysbus <0x42021c00, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16
    3 -> user_led@0

user_led: Miscellaneous.LED @ gpioh
    invert: true

user_button: Miscellaneous.Button @ gpioc
    invert: true
    -> gpioc@13
